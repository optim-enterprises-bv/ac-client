# OptimACS ac-client UCI configuration
# File: /etc/config/optimacs
#
# This is the OpenWrt-native way to configure ac-client.
# Use standard UCI tools to read and write settings:
#
#   uci get  optimacs.agent.server_host
#   uci set  optimacs.agent.server_host='controller.example.com'
#   uci commit optimacs
#   /etc/init.d/ac-client restart
#
# Or load in shell scripts via:
#   . /lib/functions.sh
#   config_load optimacs
#   config_get SERVER_HOST agent server_host
#
# After any change run:   /etc/init.d/ac-client restart
# ─────────────────────────────────────────────────────────────────────────────

# ── Agent identity ────────────────────────────────────────────────────────────
# One named section of type 'optimacs', name 'agent'.
# Access each option as:  uci get optimacs.agent.<option>

config optimacs 'agent'

	# ── Server / MTP ──────────────────────────────────────────────────────
	# Hostname or IP of the controller (used to build ws_url when
	# ws_url is left empty).
	# For local testing, use your ac-server IP: option server_host '192.168.10.5'
	option server_host   'gw.aether-io.com'

	# TCP port for the legacy ACP/TLS connection (default: 3490).
	# Also used as the fallback WS port when ws_url is not set.
	option server_port   '443'

	# TLS SNI name — must match the CN in the server's certificate.
	# For local testing, use the server IP: option server_cn '192.168.10.5'
	option server_cn     'gw.aether-io.com'

	# ── USP Message Transport Protocol (MTP) ──────────────────────────────
	# Which MTP(s) to use: websocket | mqtt | both
	option mtp           'websocket'

	# WebSocket MTP: direct WSS URL to the controller.
	# When left empty, built automatically from server_host + server_port.
	# For local testing: option ws_url 'wss://192.168.10.5:3491'
	option ws_url        'wss://gw.aether-io.com/usp'

	# MQTT MTP: URL of the EMQX (or other) broker.
	# Required only when mtp = mqtt or mtp = both.
	# option mqtt_url    'mqtt://emqx.optimcloud.com:1883'

	# ── USP endpoint identifiers ───────────────────────────────────────────
	# Agent endpoint ID sent in every USP Record.
	# Leave empty to auto-generate from the device MAC address as:
	#   os::<OUI>::<MAC-without-colons>
	# option usp_endpoint_id ''

	# Controller endpoint ID that this agent will accept messages from.
	# This must match the USP_ENDPOINT_ID configured on the controller.
	option controller_id 'oui:00005A:Aether-Controller-1'

	# Account claim token from the OptimACS dashboard.
	# Links this device to your tenant account on first Boot! connect.
	# option claim_token ''

	# ── TLS / certificate paths ────────────────────────────────────────────
	# CA certificate — used to verify the server's TLS certificate.
	# build_tls_config() seeds its trust store ONLY from this file; no system
	# or webpki roots are loaded. The default controller terminates TLS at a
	# public CA (Let's Encrypt), so this points at the ca-bundle trust store.
	# For a private controller, point this at that CA instead, e.g.
	#   option ca_file '/etc/apclient/init/ca.crt'
	option ca_file       '/etc/ssl/certs/ca-certificates.crt'

	# Init (bootstrap) certificate, used before the device is provisioned.
	option init_cert     '/etc/apclient/init/client.crt'
	option init_key      '/etc/apclient/init/client.key'

	# Provisioned certificate, written here by ac-client after a successful
	# CERT exchange with the server.
	option cert_file     '/etc/apclient/certs/client.crt'
	option key_file      '/etc/apclient/certs/client.key'

	# Directory where provisioned certs are persisted.
	option cert_dir      '/etc/apclient/certs'

	# ── Device identity ────────────────────────────────────────────────────
	# MAC address sent in INIT packets and used as the device CN.
	# Leave empty to auto-detect from br-lan / eth0 / wlan0.
	# option mac_addr    ''

	# CPU architecture string reported to the server (e.g. mipsel_24kc).
	# option arch        ''

	# Device model string reported to the server (e.g. tplink-c7).
	# option sys_model   ''

	# ── Polling intervals (seconds) ────────────────────────────────────────
	# How often ac-client polls the server for configuration changes.
	option update_interval '60'

	# How often ac-client sends a STATUS heartbeat (uptime, load, wifi …).
	#
	# This doubles as the only periodic traffic on the WebSocket MTP, so it
	# also determines whether the connection survives an idle timeout. It must
	# stay comfortably BELOW the shortest idle timeout on the path, or the
	# connection is reaped before the heartbeat ever fires and the agent
	# reconnects forever.
	#
	# Measured on the default endpoint: Cloudflare closes an idle WebSocket at
	# ~126s, the ingress behind it at ~300s. At the old default of 300 a board
	# dropped every 128-152s and re-ran the full onboard each time (~28 per
	# hour). At 60 the same board held one connection indefinitely.
	#
	# Raise this only if you know every idle timeout on your path.
	option status_interval '60'

	# How often ac-client runs a camera discovery + capture cycle.
	option cam_interval    '360'

	# ── GNSS / GPS receiver ────────────────────────────────────────────────
	# Serial device for a NMEA-0183 GPS receiver.
	# Leave empty (or comment out) to disable GPS reporting.
	# option gnss_dev    '/dev/ttyUSB0'
	option gnss_baud     '9600'

	# ── Storage paths ──────────────────────────────────────────────────────
	option fw_dir        '/tmp/firmware'
	option img_dir       '/var/apclient/images'
	option pid_file      '/var/run/apclient.pid'

	# ── Passive motion sensing ─────────────────────────────────────────────
	# Derive "is someone moving" from the RSSI variance of the mesh and
	# client links this device already has, and report only the state
	# changes (Idle <-> Motion) as Device.X_OptimACS_Sensing.Motion.{i}.State.
	#
	# OFF BY DEFAULT, and deliberately so. Presence in a home -- somebody is
	# moving about, right now, in this house -- is personal data about
	# whoever lives there, including people who never agreed to anything and
	# own none of the equipment. It is not anonymous: it arrives tagged with
	# a device that has an address and a subscriber. Switch this on only
	# where the occupants have been asked and have said yes.
	#
	# Nothing else turns it on: with this unset the sampler is never
	# started, so the device does not compute presence and quietly withhold
	# it -- it never computes it at all.
	# option motion_enabled  '0'

	# How often each link's signal is read, in milliseconds (200-5000,
	# default 500). Values outside the range are clamped.
	#
	# 500 ms matches what is being measured: a person crossing between two
	# radios takes about a second. Sampling much slower steps over the
	# crossing entirely -- the feature then looks configured and never
	# fires, which is worse than being off. Much faster costs one fork of
	# `iw` per interface per tick for readings the driver has not refreshed.
	#
	# Measured 2026-09-21 on a D50 (Cortex-A53, ipq50xx): 100 station dumps
	# in 0.72 s, about 7 ms each, so 500 ms over three interfaces is roughly
	# 4% of one core.
	# option motion_period_ms '500'

	# ── Channel-state (CSI) sensing ────────────────────────────────────────
	# A second, sharper motion sensor on the same links. Where motion
	# sensing above watches one number per link -- the RSSI, which is the
	# whole channel collapsed to a scalar -- this watches the channel
	# itself: for every sounding the 5 GHz radio reports the complex
	# response of each receive chain on each of 256 subcarriers, about a
	# thousand numbers where RSSI has one. A person changes some
	# subcarriers and leaves others alone, which is visible well before the
	# sum of them moves a whole dB. Reported as
	# Device.X_OptimACS_Sensing.Csi.{i}.State.
	#
	# REQUIRES THE CFR-CAPABLE DRIVER. This reads
	#   /sys/kernel/debug/ieee80211/phy1/ath11k/{enable_cfr,cfr_capture0}
	# which exist only on the r37 image's patched ath11k, and only on a
	# radio whose hardware can sound the channel -- on the Xunison D50 that
	# is the QCN9074 on phy1 (5 GHz). On any other build or radio the agent
	# logs "CFR not available on this radio; csi disabled" once and does
	# nothing further. It is not an error and needs no configuration.
	#
	# COSTS ~5 MB OF RAM AT BOOT, per capable radio, from the moment the
	# agent writes enable_cfr: the driver then allocates the relay buffer
	# the records are delivered through (255 sub-buffers of ~16.7 KB). On a
	# 128 MB board that is real memory, and it is allocated for as long as
	# this is switched on, whether or not anybody is moving. The agent
	# writes enable_cfr back to 0 when it stops, so the memory comes back
	# on a clean shutdown.
	#
	# OFF BY DEFAULT, and for a stronger reason than motion sensing is.
	# Motion says somebody moved. CSI measures the SHAPE of the multipath
	# they moved through -- more information about the inside of a home,
	# about people who never agreed to anything and own none of the
	# equipment -- and obtaining it puts the radio into a mode that sounds
	# the channel with extra frames addressed to each peer. Consenting to
	# motion_enabled is NOT consenting to this; it has its own switch so
	# that saying yes to one is not silently saying yes to both. Switch it
	# on only where the occupants have been asked about this specifically
	# and have said yes.
	#
	# Nothing else turns it on: with this unset the reader is never
	# started, enable_cfr is never written, and the driver never allocates
	# the buffer -- the feature is absent, not merely quiet.
	# option csi_enabled     '0'

	# How often each peer is sounded, in milliseconds (20-1000, default
	# 100). Values outside the range are clamped, and values that are not a
	# multiple of 10 are ROUNDED to one.
	#
	# The rounding is not cosmetic: the driver takes this in units of 10 ms
	# and truncates anything else, so an unrounded 105 would leave the radio
	# on 100 ms while the agent still sized its windows for 105 -- a window
	# that is never quite full and a sensor that never fires.
	#
	# 100 ms is ten looks a second, which is the rate at which a body
	# crossing a path actually changes it. It is also what the relay can
	# carry: each record is ~4.2 KB, so one peer at 100 ms is 42 KB/s. At
	# most 8 peers are captured at once across all radios, because a busy
	# AP asking for every associated client would overrun the relay and
	# lose captures from every peer -- including the mesh links worth
	# having -- with nothing in the record stream to say so.
	#
	# THE VITALS STAGE BELOW NEEDS THIS AT 120 OR LESS. It needs at least 5
	# records a second to reach the top of the heart band, and the radio
	# delivers 8-9 a second at the default 100 ms rather than 10 -- soundings
	# are missed whenever a peer is not awake to answer. Above about 180 ms
	# there is no margin left and breathing and heart go permanently empty;
	# the agent says so once per link when that happens. Fall detection is
	# unaffected: it reads the same motion energy the detector does.
	# option csi_period_ms   '100'

	# Seconds of records behind one motion-energy figure (1-10, default 2).
	# Clamped. At the default period a 2 s window holds 20 records.
	#
	# Below a second the window holds a handful of records and its variance
	# is dominated by the receiver rather than the room. Above ten a person
	# has crossed and left before the window notices.
	#
	# Measured 2026-09-22 on a QCN9074 mesh link with nobody moving: the
	# reported MotionEnergyDb sat at -22 dB and held it to within 0.6 dB
	# across every 2 s window of a 97-record capture.
	# option csi_window_secs '2'

	# ── Vital signs and falls (EXPERIMENTAL) ───────────────────────────────
	# On top of the motion energy above, the agent can look for two much
	# smaller things in the same captures: a periodicity consistent with a
	# chest, and the signature of somebody falling and then not getting up.
	# Reported as Device.X_OptimACS_Sensing.Csi.{i}.{BreathingBpm, HeartBpm,
	# VitalsConfidence, FallCandidate, LastFallAt}. They need no switch of
	# their own: they are computed whenever csi_enabled is set, from records
	# that are already being captured, and they cost the radio nothing extra.
	#
	# READ THIS BEFORE USING THE BREATHING AND HEART NUMBERS.
	#
	# THEY ARE NOT MEDICAL MEASUREMENTS. They are experimental candidates.
	# This is not a medical device, nothing here is approved as one, and no
	# alarm, dosage, call, or clinical decision should be wired to these
	# values. What the agent actually reports is a periodicity in a radio
	# channel that falls inside a band a chest also falls inside. It cannot
	# tell a chest from a fan, a fish-tank pump, a washing machine on a
	# shared wall, or a curtain in a draught.
	#
	# THEY NEED A STILL SUBJECT INSIDE THE LINK'S OWN PATH. The link has to
	# have been Idle -- no gross motion at all -- for a whole window before
	# anything is estimated, and the person has to be sitting or lying in
	# the volume the radio path actually passes through. Somebody breathing
	# in the next room, or in the same room but off the path, changes
	# nothing the radio can see.
	#
	# A MESH LINK BETWEEN ROOMS MAY NEVER SEE ONE. The links this runs on
	# are the ones the device already has, and a backhaul between a hallway
	# and a landing may have no chair, no bed, and nobody still in it from
	# one year to the next. On such a link the honest output is empty
	# BreathingBpm and HeartBpm for ever, and that is what it will report.
	# Empty is the normal answer. It is not a fault and there is nothing to
	# configure to change it.
	#
	# FallCandidate is a shape in the energy -- a fast rise well above the
	# link's own ambient, a return to that ambient within a few seconds, and
	# then a long stillness -- not a diagnosis. A dropped chair followed by
	# somebody leaving the room has the same shape.
	#
	# Only FallCandidate sends a ValueChange notification, on both edges.
	# The breathing and heart values change every couple of seconds and are
	# picked up by the ordinary poll.

	# Seconds of records behind one vitals estimate, and the stillness
	# required before one is made at all (20-120, default 30). Clamped.
	#
	# Below twenty a 0.1 Hz breath -- six a minute, the slow end of the band
	# -- has two cycles in the window and cannot be told from a drift. Above
	# two minutes the subject has to hold still for two minutes, which
	# nobody does, and the answer is stale by the time it is reported.
	#
	# The window has to be CONTINUOUS. A gap of more than five sounding
	# periods -- 500 ms at the default -- empties it and the agent starts
	# again, because the transform assumes records are evenly spaced and a
	# hole puts every sample after it at the wrong time rather than merely
	# leaving one out. The live links deliver 8-9 of every 10 soundings and
	# drop them in ones and twos, which five periods absorbs; a link that
	# loses half a second at a time will report vitals rarely or never,
	# which is the honest outcome: the alternative is a breathing rate read
	# off a smeared spectrum. The values also go blank as soon as the link has
	# been quiet for longer than one window, rather than standing until the
	# link ages out of the table a minute later.
	# option csi_vitals_window_secs   '30'

	# Confidence below which nothing is reported (0.1-0.9, default 0.35).
	# Clamped. Reported as VitalsConfidence whether or not it clears the
	# floor, so a near miss is visible.
	#
	# The confidence is how much MORE of the 0.05-4 Hz power sits in the
	# band than would sit there if the link were just noise, rescaled so
	# that 0 is exactly what an empty room gives and 1 is a pure tone. The
	# raw share could not be used for this: a band's share of a flat
	# spectrum is only its share of the width, which is 0.10 for the 0.4 Hz
	# breathing band and 0.31 for the 1.2 Hz heart band -- one threshold
	# would have meant two different things. With the chance level taken
	# out it means one thing in both: measured over twelve windows of white
	# noise, breathing averages 0.036 and the heart 0.025, and no window of
	# either came within a factor of two of the shipped 0.35, while a clean
	# tone in either band scores 0.99.
	#
	# One thing the floor cannot fix: within ONE series the two bands still
	# compete for the same total, so a breath four times the amplitude of a
	# pulse takes sixteen times the power and leaves the pulse below any
	# useful floor. That is why the agent transforms the magnitude and the
	# phase separately and lets each band take whichever carries it better
	# -- in practice the breath shows in the magnitude and the pulse in the
	# phase. A link whose phase is too noisy will report breathing and
	# nothing else however still the subject is.
	# option csi_vitals_min_confidence '0.35'

	# dB above a link's learnt ambient that opens a fall candidate (6-30,
	# default 12). Clamped.
	#
	# A body hitting the floor inside the path is the largest thing that
	# happens to a channel short of the radio changing channel. Twelve is
	# well above the few dB somebody walking through produces. Below six is
	# inside what a door closing does; above thirty is past the top of the
	# reported MotionEnergyDb range.
	# option csi_fall_rise_db         '12'

	# Seconds of stillness after the energy comes back down before a
	# candidate is raised (5-60, default 10). Clamped.
	#
	# This is the whole discriminator. A rise and a return is somebody
	# sitting down; a rise, a return, and then nobody moving for ten seconds
	# is the thing worth reporting. Under five seconds a person who sat down
	# heavily and then reached for something is a fall. Over a minute the
	# report arrives long after it was any use.
	#
	# A raised candidate clears itself after 60 s, or as soon as motion
	# resumes on the link, and no second candidate is raised within 5 s of
	# the first.
	# option csi_fall_still_secs      '10'

	# ── Process behaviour ──────────────────────────────────────────────────
	# Send log messages to syslog (1) or stderr (0).
	option log_syslog    '1'
