# OptimACS ac-client UCI configuration
# File: /etc/config/optimacs
#
# This is the OpenWrt-native way to configure ac-client.
# Use standard UCI tools to read and write settings:
#
#   uci get  optimacs.agent.server_host
#   uci set  optimacs.agent.server_host='controller.example.com'
#   uci commit optimacs
#   /etc/init.d/ac-client restart
#
# Or load in shell scripts via:
#   . /lib/functions.sh
#   config_load optimacs
#   config_get SERVER_HOST agent server_host
#
# After any change run:   /etc/init.d/ac-client restart
# ─────────────────────────────────────────────────────────────────────────────

# ── Agent identity ────────────────────────────────────────────────────────────
# One named section of type 'optimacs', name 'agent'.
# Access each option as:  uci get optimacs.agent.<option>

config optimacs 'agent'

	# ── Server / MTP ──────────────────────────────────────────────────────
	# Hostname or IP of the controller (used to build ws_url when
	# ws_url is left empty).
	# For local testing, use your ac-server IP: option server_host '192.168.10.5'
	option server_host   'gw.aether-io.com'

	# TCP port for the legacy ACP/TLS connection (default: 3490).
	# Also used as the fallback WS port when ws_url is not set.
	option server_port   '443'

	# TLS SNI name — must match the CN in the server's certificate.
	# For local testing, use the server IP: option server_cn '192.168.10.5'
	option server_cn     'gw.aether-io.com'

	# ── USP Message Transport Protocol (MTP) ──────────────────────────────
	# Which MTP(s) to use: websocket | mqtt | both
	option mtp           'websocket'

	# WebSocket MTP: direct WSS URL to the controller.
	# When left empty, built automatically from server_host + server_port.
	# For local testing: option ws_url 'wss://192.168.10.5:3491'
	option ws_url        'wss://gw.aether-io.com/usp'

	# MQTT MTP: URL of the EMQX (or other) broker.
	# Required only when mtp = mqtt or mtp = both.
	# option mqtt_url    'mqtt://emqx.optimcloud.com:1883'

	# ── USP endpoint identifiers ───────────────────────────────────────────
	# Agent endpoint ID sent in every USP Record.
	# Leave empty to auto-generate from the device MAC address as:
	#   os::<OUI>::<MAC-without-colons>
	# option usp_endpoint_id ''

	# Controller endpoint ID that this agent will accept messages from.
	# This must match the USP_ENDPOINT_ID configured on the controller.
	option controller_id 'oui:00005A:Aether-Controller-1'

	# Account claim token from the OptimACS dashboard.
	# Links this device to your tenant account on first Boot! connect.
	# option claim_token ''

	# ── TLS / certificate paths ────────────────────────────────────────────
	# CA certificate — used to verify the server's TLS certificate.
	# build_tls_config() seeds its trust store ONLY from this file; no system
	# or webpki roots are loaded. The default controller terminates TLS at a
	# public CA (Let's Encrypt), so this points at the ca-bundle trust store.
	# For a private controller, point this at that CA instead, e.g.
	#   option ca_file '/etc/apclient/init/ca.crt'
	option ca_file       '/etc/ssl/certs/ca-certificates.crt'

	# Init (bootstrap) certificate, used before the device is provisioned.
	option init_cert     '/etc/apclient/init/client.crt'
	option init_key      '/etc/apclient/init/client.key'

	# Provisioned certificate, written here by ac-client after a successful
	# CERT exchange with the server.
	option cert_file     '/etc/apclient/certs/client.crt'
	option key_file      '/etc/apclient/certs/client.key'

	# Directory where provisioned certs are persisted.
	option cert_dir      '/etc/apclient/certs'

	# ── Device identity ────────────────────────────────────────────────────
	# MAC address sent in INIT packets and used as the device CN.
	# Leave empty to auto-detect from br-lan / eth0 / wlan0.
	# option mac_addr    ''

	# CPU architecture string reported to the server (e.g. mipsel_24kc).
	# option arch        ''

	# Device model string reported to the server (e.g. tplink-c7).
	# option sys_model   ''

	# ── Polling intervals (seconds) ────────────────────────────────────────
	# How often ac-client polls the server for configuration changes.
	option update_interval '60'

	# How often ac-client sends a STATUS heartbeat (uptime, load, wifi …).
	#
	# This doubles as the only periodic traffic on the WebSocket MTP, so it
	# also determines whether the connection survives an idle timeout. It must
	# stay comfortably BELOW the shortest idle timeout on the path, or the
	# connection is reaped before the heartbeat ever fires and the agent
	# reconnects forever.
	#
	# Measured on the default endpoint: Cloudflare closes an idle WebSocket at
	# ~126s, the ingress behind it at ~300s. At the old default of 300 a board
	# dropped every 128-152s and re-ran the full onboard each time (~28 per
	# hour). At 60 the same board held one connection indefinitely.
	#
	# Raise this only if you know every idle timeout on your path.
	option status_interval '60'

	# How often ac-client runs a camera discovery + capture cycle.
	option cam_interval    '360'

	# ── GNSS / GPS receiver ────────────────────────────────────────────────
	# Serial device for a NMEA-0183 GPS receiver.
	# Leave empty (or comment out) to disable GPS reporting.
	# option gnss_dev    '/dev/ttyUSB0'
	option gnss_baud     '9600'

	# ── Storage paths ──────────────────────────────────────────────────────
	option fw_dir        '/tmp/firmware'
	option img_dir       '/var/apclient/images'
	option pid_file      '/var/run/apclient.pid'

	# ── Passive motion sensing ─────────────────────────────────────────────
	# Derive "is someone moving" from the RSSI variance of the mesh and
	# client links this device already has, and report only the state
	# changes (Idle <-> Motion) as Device.X_OptimACS_Sensing.Motion.{i}.State.
	#
	# OFF BY DEFAULT, and deliberately so. Presence in a home -- somebody is
	# moving about, right now, in this house -- is personal data about
	# whoever lives there, including people who never agreed to anything and
	# own none of the equipment. It is not anonymous: it arrives tagged with
	# a device that has an address and a subscriber. Switch this on only
	# where the occupants have been asked and have said yes.
	#
	# Nothing else turns it on: with this unset the sampler is never
	# started, so the device does not compute presence and quietly withhold
	# it -- it never computes it at all.
	# option motion_enabled  '0'

	# How often each link's signal is read, in milliseconds (200-5000,
	# default 500). Values outside the range are clamped.
	#
	# 500 ms matches what is being measured: a person crossing between two
	# radios takes about a second. Sampling much slower steps over the
	# crossing entirely -- the feature then looks configured and never
	# fires, which is worse than being off. Much faster costs one fork of
	# `iw` per interface per tick for readings the driver has not refreshed.
	#
	# Measured 2026-09-21 on a D50 (Cortex-A53, ipq50xx): 100 station dumps
	# in 0.72 s, about 7 ms each, so 500 ms over three interfaces is roughly
	# 4% of one core.
	# option motion_period_ms '500'

	# ── Process behaviour ──────────────────────────────────────────────────
	# Send log messages to syslog (1) or stderr (0).
	option log_syslog    '1'
